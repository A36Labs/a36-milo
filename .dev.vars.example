# A36 Milo local-development secrets
#
# Copy this file:
#   cp .dev.vars.example .dev.vars
#
# Replace the placeholder values inside .dev.vars.
# Never commit the real .dev.vars file.

TELEGRAM_BOT_TOKEN="replace_with_your_telegram_bot_token"

TELEGRAM_WEBHOOK_SECRET="replace_with_a_random_webhook_secret"

GEMINI_API_KEY="replace_with_your_gemini_api_key"
